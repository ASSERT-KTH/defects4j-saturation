+    /**
+     * Eagerly infers property types for any key of {@code objLit} that
+     * doesn't already have a declared type.
+     *
+     * This is used when an object literal is assigned wholesale to the
+     * .prototype of an already-declared constructor or interface (see
+     * #maybeDeclareQualifiedName): once that happens, the object literal
+     * becomes that function's real, reference-named prototype object, and
+     * TypeInference's generic object-literal property inference skips
+     * reference-named objects. So we replicate that inference here,
+     * eagerly, while the object literal still has an (empty) reference
+     * name -- but only after its implicit prototype has already been
+     * hooked up (see the caller), so that any "unknown superclass" taint
+     * is correctly reflected in the inferred property types.
+     */
+    void inferObjectLitPropertiesEagerly(Node objLit, ObjectType objLitType) {
+      for (Node keyNode = objLit.getFirstChild(); keyNode != null;
+           keyNode = keyNode.getNext()) {
+        String memberName = NodeUtil.getObjectLitKeyName(keyNode);
+        if (objLitType.hasOwnProperty(memberName)) {
+          continue;
+        }
+        Node value = keyNode.getFirstChild();
+        JSType rawValueType = value == null ? null : value.getJSType();
+        JSType inferredKeyType =
+            NodeUtil.getObjectLitKeyTypeFromValueType(keyNode, rawValueType);
+        objLitType.defineInferredProperty(
+            memberName,
+            inferredKeyType == null ? unknownType : inferredKeyType,
+            keyNode);
+      }
+    }
