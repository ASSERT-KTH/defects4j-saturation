+    /**
+     * Method called when a new match is found: this happens when a filter,
+     * previously not {@link TokenFilter#INCLUDE_ALL}, becomes
+     * <code>INCLUDE_ALL</code>, indicating start of an included subtree.
+     * Used to enforce {@link #_allowMultipleMatches}: if a match had already
+     * been found earlier and multiple matches are not allowed, further
+     * matches are suppressed.
+     */
+    protected boolean _verifyAllowedMatches() throws IOException {
+        if (_matchCount == 0 || _allowMultipleMatches) {
+            ++_matchCount;
+            return true;
+        }
+        return false;
+    }
