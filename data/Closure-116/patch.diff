+    // If the body of the function being inlined has a side-effect (a call,
+    // an assignment, etc.) then any parameter whose value could itself be
+    // changed by a side-effect (a mutable global, a property access, etc.)
+    // can no longer be safely evaluated in-place: at the call site the
+    // argument is always evaluated before the function body runs, but once
+    // inlined it would be evaluated interleaved with the function's own
+    // side-effects, potentially changing its value or the order in which
+    // side-effects are observed.
+    Node returnValue = block.hasOneChild()
+        ? block.getFirstChild().getFirstChild() : null;
+    boolean returnValueMayHaveSideEffects =
+        returnValue != null && NodeUtil.mayHaveSideEffects(
+            returnValue, compiler);
 
