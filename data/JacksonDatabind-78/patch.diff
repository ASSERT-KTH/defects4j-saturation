     /**
+     * Helper method called to check whether given raw type is a possible
+     * "nasty class" that we do not want to deserialize, as it will likely
+     * expose security vulnerabilities (usually via a mechanism such as
+     * default typing).
+     *
      * @since 2.8.9
      */
         // There are certain nasty classes that could cause problems, mostly
         // via default typing -- catch them here.
+    protected void checkIllegalTypes(DeserializationContext ctxt, JavaType type,
+            BeanDescription beanDesc)
+        throws JsonMappingException
+    {
+        final String full = type.getRawClass().getName();
+        if (_cachedIllegalClassNames.contains(full)) {
+            throw JsonMappingException.from(ctxt,
+                    String.format("Illegal type (%s) to deserialize: prevented for security reasons", full));
+        }
+    }
 
