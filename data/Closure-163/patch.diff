+    /**
+     * Determines whether the object whose prototype is being modified is
+     * reachable from the global scope, i.e., whether its root variable is a
+     * global variable. If it is not (e.g., it's a local variable of some
+     * enclosing function), then any properties assigned to its prototype
+     * cannot safely be moved to a different module, since the object itself
+     * would not be reachable from that module.
+     */
+    private boolean isGloballyAccessible(NodeTraversal t, Node qualifiedName) {
+      Node root = NodeUtil.getRootOfQualifiedName(qualifiedName);
+      if (!root.isName()) {
+        return false;
+      }
+      Var var = t.getScope().getVar(root.getString());
+      return var != null && var.isGlobal();
+    }
