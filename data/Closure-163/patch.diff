+    /**
+     * If {@code n} is the value of a key in an object literal that is being
+     * assigned to a prototype (as in {@code Foo.prototype = {bar: function()
+     * {...}}}), returns the name of that key. Otherwise returns null.
+     */
+    private String getPrototypeLiteralPropertyName(Node n) {
+      Node key = n.getParent();
+      if (key == null || key.getFirstChild() != n) {
+        return null;
+      }
+      Node objLit = key.getParent();
+      if (objLit == null || !objLit.isObjectLit()) {
+        return null;
+      }
+      Node assign = objLit.getParent();
+      if (assign == null || !assign.isAssign() ||
+          assign.getLastChild() != objLit) {
+        return null;
+      }
+      Node lhs = assign.getFirstChild();
+      if (lhs.isGetProp() &&
+          lhs.getLastChild().getString().equals("prototype")) {
+        return key.getString();
+      }
+      return null;
+    }
