+  /**
+   * Rotates a right-nested associative expression, e.g. "a op (b op c)", so
+   * that it becomes left-nested, "(a op b) op c". This lets the code
+   * generator print the expression without adding parentheses. Only done
+   * late, since the rotated shape is less convenient for earlier passes
+   * (e.g. it breaks up the natural nesting created by if/else-chain
+   * folding).
+   */
+  private Node tryRotateAssociativeOperator(Node n) {
+    if (!late) {
+      return n;
+    }
+
+    Node right = n.getLastChild();
+    if (right.getType() != n.getType()) {
+      return n;
+    }
+
+    Node left = n.getFirstChild();
+    right.detachFromParent();
+    left.detachFromParent();
+
+    Node rightLeft = right.getFirstChild();
+    Node rightRight = right.getLastChild();
+    rightLeft.detachFromParent();
+    rightRight.detachFromParent();
+
+    Node newLeft = new Node(n.getType(), left, rightLeft).srcref(n);
+    n.addChildToFront(newLeft);
+    n.addChildToBack(rightRight);
+
+    reportCodeChange();
+    return n;
+  }
