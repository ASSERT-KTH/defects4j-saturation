+    /**
+     * Print the specified text to the specified PrintWriter, preserving
+     * leading whitespace at the start of each line.
+     *
+     * @param pw The printWriter to write the help to
+     * @param width The number of characters to display per line
+     * @param text The text to be written to the PrintWriter
+     */
+    private void renderWrappedTextBlock(PrintWriter pw, int width, String text)
+    {
+        StringBuffer sb = new StringBuffer(text.length());
+
+        renderWrappedTextBlock(sb, width, 0, text);
+        pw.println(sb.toString());
+    }
