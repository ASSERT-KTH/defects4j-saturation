@@ -1051,6 +1051,16 @@ class TypeInference
           call.getChildAtIndex(1).siblings(),
           resolvedTypes);
     }
+
+    // Template types belonging to the type of "this" (e.g. inherited from a
+    // generic constructor) are not filled in by the arguments of a method
+    // call; they must already be resolved on the receiver. Trying to
+    // re-infer them from unrelated call arguments produces bogus bindings.
+    if (!fnType.isConstructor()) {
+      resolvedTypes.keySet().removeAll(
+          fnType.getTypeOfThis().getTemplateTypeMap().getTemplateKeys());
+    }
+
     return resolvedTypes;
   }
 
