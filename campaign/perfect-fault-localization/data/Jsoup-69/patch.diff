diff --git a/src/main/java/org/jsoup/nodes/Element.java b/src/main/java/org/jsoup/nodes/Element.java
index f9746e5..2fc9d18 100644
--- a/src/main/java/org/jsoup/nodes/Element.java
+++ b/src/main/java/org/jsoup/nodes/Element.java
@@ -610,6 +610,31 @@ public class Element extends Node {
         return this;
     }
 
+    /**
+     * Remove (delete) this element from the DOM tree. If this element has children, they are also removed. If this
+     * element (or one of its descendants) is a control associated with a {@link FormElement}, it is also
+     * disassociated from that form.
+     */
+    @Override
+    public void remove() {
+        FormElement form = formOwner();
+        if (form != null) {
+            for (Element el : getAllElements())
+                form.removeElement(el);
+        }
+        super.remove();
+    }
+
+    private FormElement formOwner() {
+        Element el = parent();
+        while (el != null) {
+            if (el instanceof FormElement)
+                return (FormElement) el;
+            el = el.parent();
+        }
+        return null;
+    }
+
