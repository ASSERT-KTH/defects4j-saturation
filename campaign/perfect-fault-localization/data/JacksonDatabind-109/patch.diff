+    /**
+     * Specialized serializer used for {@link BigDecimal} when it is to be
+     * written as a JSON String (see {@link JsonFormat.Shape#STRING}), taking
+     * into account {@link JsonGenerator.Feature#WRITE_BIGDECIMAL_AS_PLAIN}
+     * so that the resulting String representation matches what would have
+     * been written had the value been output as a native JSON number.
+     *
+     * @since 2.9.9 (part of fix for [databind#2230])
+     */
+    static class BigDecimalAsStringSerializer extends ToStringSerializer {
+        private static final long serialVersionUID = 1L;
+
+        public BigDecimalAsStringSerializer() {
+            super(BigDecimal.class);
+        }
+
+        @Override
+        public void serialize(Object value, JsonGenerator g, SerializerProvider provider) throws IOException {
+            BigDecimal v = (BigDecimal) value;
+            g.writeString(g.isEnabled(JsonGenerator.Feature.WRITE_BIGDECIMAL_AS_PLAIN)
+                    ? v.toPlainString() : v.toString());
+        }
+    }
