+    /**
+     * Helper method called to prevent deserialization of specific "nasty" classes
+     * that are known to be usable as part of "polymorphic exploits" wherein malicious
+     * code can be executed via seemingly innocent payload, by deserializing a Bean
+     * of type that has side effects on construction, or via chained methods being called.
+     *
+     * @since 2.8.9
+     */
+    protected void checkIllegalTypes(DeserializationContext ctxt, JavaType type,
+            BeanDescription beanDesc)
+        throws JsonMappingException
+    {
+        // There are certain nasty classes that could cause problems, mostly
+        // via default typing -- catch if we either have them configured
+        // explicitly, or are being asked to resolve them as default typing.
+        final String full = type.getRawClass().getName();
+        if (DEFAULT_NO_DESER_CLASS_NAMES.contains(full)) {
+            throw JsonMappingException.from(ctxt,
+                    String.format("Illegal type (%s) to deserialize: prevented for security reasons", full));
+        }
+    }
