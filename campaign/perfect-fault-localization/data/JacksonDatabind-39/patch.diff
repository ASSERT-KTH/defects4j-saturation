diff --git a/src/main/java/com/fasterxml/jackson/databind/deser/std/NullifyingDeserializer.java b/src/main/java/com/fasterxml/jackson/databind/deser/std/NullifyingDeserializer.java
index 5bc789f..dee0203 100644
--- a/src/main/java/com/fasterxml/jackson/databind/deser/std/NullifyingDeserializer.java
+++ b/src/main/java/com/fasterxml/jackson/databind/deser/std/NullifyingDeserializer.java
@@ -32,7 +32,20 @@ public class NullifyingDeserializer
     {
         // 29-Jan-2016, tatu: Simple skipping for all other tokens, but FIELD_NAME bit
         //    special unfortunately
+        if (p.getCurrentToken() == JsonToken.FIELD_NAME) {
+            // Parser may be positioned on a field name (rather than the value
+            // itself or an enclosing START_OBJECT/START_ARRAY), for example when
+            // buffered tokens (like a re-inserted type id) are flattened together
+            // with the original stream. In that case skipChildren() is a no-op,
+            // so we need to manually consume name/value pairs until the matching
+            // END_OBJECT is reached.
+            do {
+                p.nextToken(); // move to the value
+                p.skipChildren();
+            } while (p.nextToken() == JsonToken.FIELD_NAME);
+        } else {
             p.skipChildren();
+        }
         return null;
     }
 
