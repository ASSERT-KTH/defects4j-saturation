+    /**
+     * Read the BOM (if present) at the start of the byte buffer to determine the character set it represents. If
+     * a BOM is found, the buffer's position is advanced past it, so that a subsequent decode will not include the
+     * BOM bytes.
+     * @param byteData the buffer to inspect
+     * @return the charset represented by the BOM, or null if none was found
+     */
+    private static BomCharset detectCharsetFromBom(final ByteBuffer byteData) {
+        final byte[] bom = new byte[4];
+        byteData.mark();
+        byteData.get(bom, 0, Math.min(byteData.remaining(), bom.length));
+        byteData.rewind();
+
+        if (bom[0] == 0x00 && bom[1] == 0x00 && bom[2] == (byte) 0xFE && bom[3] == (byte) 0xFF || // BE
+                bom[0] == (byte) 0xFF && bom[1] == (byte) 0xFE && bom[2] == 0x00 && bom[3] == 0x00) { // LE
+            byteData.position(4);
+            return new BomCharset(bom[0] == 0x00 ? "UTF-32BE" : "UTF-32LE");
+        } else if (bom[0] == (byte) 0xFE && bom[1] == (byte) 0xFF || // BE
+                bom[0] == (byte) 0xFF && bom[1] == (byte) 0xFE) { // LE
+            byteData.position(2);
+            return new BomCharset(bom[0] == (byte) 0xFE ? "UTF-16BE" : "UTF-16LE");
+        } else if (bom[0] == (byte) 0xEF && bom[1] == (byte) 0xBB && bom[2] == (byte) 0xBF) { // UTF-8
+            byteData.position(3);
+            return new BomCharset("UTF-8");
+        }
+        return null;
+    }
