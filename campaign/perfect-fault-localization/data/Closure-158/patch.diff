+  /**
+   * Builds a {@link WarningGuardSpec} from the --jscomp_error/warning/off
+   * flags, preserving the order in which they appeared on the command-line.
+   */
+  private static WarningGuardSpec createWarningGuardSpec(Flags flags) {
+    WarningGuardSpec spec = new WarningGuardSpec();
+    for (WarningGuardSpec.Entry entry : flags.warningGuardEntries) {
+      spec.add(entry.level, entry.groupName);
+    }
+    return spec;
+  }
