+  /**
+   * Rename the labels declared in the function body being inlined so that
+   * they can not collide with labels already in scope at the call site.
+   */
+  private static class RenameLabels implements NodeTraversal.Callback {
+    private final Supplier<String> labelNameSupplier;
+    private final Map<String, String> renameMap = new HashMap<String, String>();
+
+    RenameLabels(Supplier<String> labelNameSupplier) {
+      this.labelNameSupplier = labelNameSupplier;
+    }
+
+    @Override
+    public boolean shouldTraverse(NodeTraversal t, Node n, Node parent) {
+      // Labels do not cross function boundaries.
+      return n.getType() != Token.FUNCTION || parent == null;
+    }
+
+    @Override
+    public void visit(NodeTraversal t, Node n, Node parent) {
+      switch (n.getType()) {
+        case Token.LABEL: {
+          Node labelNameNode = n.getFirstChild();
+          String name = labelNameNode.getString();
+          String newName = labelNameSupplier.get();
+          renameMap.put(name, newName);
+          labelNameNode.setString(newName);
+          break;
+        }
+        case Token.BREAK:
+        case Token.CONTINUE: {
+          Node labelNameNode = n.getFirstChild();
+          if (labelNameNode != null) {
+            String newName = renameMap.get(labelNameNode.getString());
+            if (newName != null) {
+              labelNameNode.setString(newName);
+            }
+          }
+          break;
+        }
+      }
+    }
+  }
+
