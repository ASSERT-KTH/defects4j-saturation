+  /**
+   * Determines whether a string is a "simple number": a sequence of digits
+   * that does not start with a leading zero (unless the value is exactly
+   * "0"). Such strings can be used, without loss of information, as the
+   * textual form of an object literal property name that is a non-negative
+   * integer.
+   */
+  static boolean isSimpleNumber(String s) {
+    int len = s.length();
+    for (int index = 0; index < len; index++) {
+      char c = s.charAt(index);
+      if (c < '0' || c > '9') {
+        return false;
+      }
+    }
+    return len > 0 && (len == 1 || s.charAt(0) != '0');
+  }
