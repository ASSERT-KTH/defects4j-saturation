@@ -1166,6 +1166,15 @@ public class ObjectReader
     @SuppressWarnings("unchecked")
     @Override
     public <T extends TreeNode> T readTree(JsonParser p) throws IOException {
+        // Must check for EOF here before calling _bindAsTree(), since that
+        // otherwise returns "missing node" instead of `null`
+        JsonToken t = p.getCurrentToken();
+        if (t == null) {
+            t = p.nextToken();
+            if (t == null) {
+                return null;
+            }
+        }
