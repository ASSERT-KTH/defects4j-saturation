+    /**
+     * Serializer used for {@link BigDecimal} when it is to be written as
+     * a JSON String, needing to still respect
+     * {@link com.fasterxml.jackson.core.JsonGenerator.Feature#WRITE_BIGDECIMAL_AS_PLAIN}.
+     *
+     * @since 2.10
+     */
+    static class BigDecimalAsStringSerializer extends ToStringSerializer
+    {
+        private static final long serialVersionUID = 1L;
+
+        public BigDecimalAsStringSerializer() {
+            super(BigDecimal.class);
+        }
+
+        @Override
+        public void serialize(Object value, JsonGenerator g, SerializerProvider provider) throws IOException
+        {
+            BigDecimal v = (BigDecimal) value;
+            if (g.isEnabled(JsonGenerator.Feature.WRITE_BIGDECIMAL_AS_PLAIN)) {
+                g.writeString(v.toPlainString());
+            } else {
+                g.writeString(v.toString());
+            }
+        }
+    }
+
