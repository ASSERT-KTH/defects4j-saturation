+    /**
+     * Checks that a tar header record carries a genuine checksum.
+     *
+     * <p>A tar header's checksum field is computed with all of its bytes
+     * treated as spaces, so any real header contributes at least the sum
+     * of those 8 spaces (256) to its own checksum and can therefore never
+     * have a checksum of zero. A record whose checksum field is missing
+     * (i.e. made up of NULs, as {@link #parseOctal} treats an all-NUL
+     * field as 0) cannot be a valid tar header, even though its other
+     * fields may happen to parse without error - typically because the
+     * bytes past the actual content of a short, non-tar stream are
+     * zero-padded.</p>
+     *
+     * @param header The tar entry header buffer to check.
+     * @return {@code true} if the header carries a non-zero checksum,
+     * {@code false} otherwise.
+     */
+    public static boolean verifyCheckSum(final byte[] header) {
+        try {
+            return parseOctal(header, TarConstants.CHKSUM_OFFSET,
+                               TarConstants.CHKSUMLEN) != 0;
+        } catch (IllegalArgumentException e) {
+            return false;
+        }
+    }
