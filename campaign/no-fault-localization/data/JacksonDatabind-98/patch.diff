+    /**
+     * Helper method used to deserialize a type id embedded as a {@link String}
+     * into whatever type the corresponding creator property actually expects
+     * (for example an {@code enum}), using its regular value deserializer.
+     *
+     * @since 2.9.6
+     */
+    @SuppressWarnings("resource")
+    protected final Object _deserializeTypeId(JsonParser p, DeserializationContext ctxt,
+            String typeId, SettableBeanProperty typeIdProp) throws IOException
+    {
+        TokenBuffer buf = new TokenBuffer(p, ctxt);
+        buf.writeString(typeId);
+        JsonParser p2 = buf.asParser(p);
+        p2.nextToken();
+        return typeIdProp.deserialize(p2, ctxt);
+    }
+
