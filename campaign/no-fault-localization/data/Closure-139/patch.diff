+    private void rewriteFunctionDeclaration(Node n) {
       // Prepare a spot for the function.
+      Node parent = n.getParent();
+      Node name = n.getFirstChild();
+      Node emptyName = Node.newString(Token.NAME, "");
+      emptyName.copyInformationFrom(name);
+      n.replaceChild(name, emptyName);
 
       // Prepare the function
+      Node var = new Node(Token.VAR, name);
+      var.copyInformationFromForTree(n);
 
       // Move the function
+      parent.replaceChild(n, var);
+      name.addChildToFront(n);
 
+      reportCodeChange("Function declaration");
+    }
 
