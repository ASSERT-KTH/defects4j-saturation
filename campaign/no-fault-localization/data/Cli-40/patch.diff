+    /**
+     * Create a number from a String using the given class, which must
+     * be a subclass of {@link Number}, and which must either provide
+     * a constructor which takes a single argument of type
+     * {@link String} or a <code>valueOf</code> factory method that
+     * takes a single argument of type <code>String</code>.
+     *
+     * @param str the value
+     * @param clazz the type of number to create
+     * @return the number represented by <code>str</code>
+     * @throws ParseException if <code>str</code> is not a number
+     */
+    private static Number createNumber(final String str, final Class<?> clazz) throws ParseException
+    {
+        try
+        {
+            return (Number) clazz.getConstructor(String.class).newInstance(str);
+        }
+        catch (final Exception e)
+        {
+            throw new ParseException(e.getClass().getName() + "; Unable to create a number of type " + clazz.getName() + " from " + str);
+        }
+    }
