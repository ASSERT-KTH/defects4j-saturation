+  /**
+   * Determines whether a function-valued object literal property (identified
+   * by its key node) is being lent to some type's prototype via a
+   * {@code @lends} annotation on the enclosing object literal.
+   */
+  private boolean isLentToPrototype(Node key) {
+    Node objectLit = key.getParent();
+    JSDocInfo jsDoc = objectLit.getJSDocInfo();
+    return jsDoc != null &&
+        jsDoc.getLendsName() != null &&
+        jsDoc.getLendsName().endsWith(".prototype");
+  }
