      *  Heuristic to determine if the current buffer looks like binary content. Reader will already hopefully be
      *  decoded correctly, so a bunch of NULLs indicates a binary file
      */
-
-
+    boolean isBinary() {
+        int size = Math.min(bufLength - bufPos, maxBufferLen);
+        if (size < 16) return false; // not enough content to make a call
+
+        int nullCount = 0;
+        for (int i = 0; i < size; i++) {
+            if (charBuf[bufPos + i] == '\u0000') {
+                nullCount++;
+                if (nullCount > 10) // a couple of NULs can turn up in odd but valid markup; a bunch means binary
+                    return true;
+            }
+        }
+        return false;
+    }
 
