+    @Override
+    public String findEnumValue(Enum<?> value) {
+        Class<?> enumClass = value.getDeclaringClass();
+        String enumName = value.name();
+        try {
+            Field field = enumClass.getField(enumName);
+            JsonProperty ann = field.getAnnotation(JsonProperty.class);
+            if (ann != null) {
+                String name = ann.value();
+                if (name.length() > 0) {
+                    return name;
+                }
+            }
+        } catch (SecurityException e) {
+        } catch (NoSuchFieldException e) {
+        }
+        return enumName;
+    }
