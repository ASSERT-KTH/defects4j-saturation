+  /**
+   * Determines whether a function with an explicit {@code this} type may
+   * be invoked via the given callee expression. Functions that require a
+   * specific {@code this} type must be called as a method (i.e. through a
+   * GETPROP or GETELEM), unless the actual value of {@code this} at the
+   * call site (the global object, for calls that aren't method calls) is
+   * itself compatible with the required type.
+   */
+  private boolean isCallableWithThisType(
+      NodeTraversal t, Node callee, FunctionType functionType) {
+    int calleeType = callee.getType();
+    if (calleeType == Token.GETPROP || calleeType == Token.GETELEM) {
+      return true;
+    }
+    JSType typeOfThis = functionType.getTypeOfThis();
+    if (typeOfThis.isUnknownType()) {
+      return true;
+    }
+    JSType globalThis = getNativeType(JSTypeNative.GLOBAL_THIS);
+    return globalThis.isSubtype(typeOfThis);
+  }
+
