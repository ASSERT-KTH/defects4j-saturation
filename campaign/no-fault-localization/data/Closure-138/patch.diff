+  private void widenOuterVarsAssignedInScope(Node n) {
+    if (n.getType() == Token.FUNCTION && n != syntacticScope.getRootNode()) {
+      // Don't descend into nested functions; their own scope analysis will
+      // widen any outer variables they assign.
+      return;
+    }
+
+    if (n.getType() == Token.ASSIGN) {
+      Node lhs = n.getFirstChild();
+      if (lhs.getType() == Token.NAME) {
+        Var var = syntacticScope.getVar(lhs.getString());
+        if (var != null && var.getScope() != syntacticScope &&
+            var.isTypeInferred()) {
+          JSType assignedType = getLiteralType(n.getLastChild());
+          if (assignedType != null) {
+            JSType oldType = var.getType();
+            var.setType(oldType == null ?
+                assignedType : oldType.getLeastSupertype(assignedType));
+          }
+        }
+      }
+    }
+
+    for (Node child = n.getFirstChild(); child != null;
+         child = child.getNext()) {
+      widenOuterVarsAssignedInScope(child);
+    }
+  }
+
+  /**
+   * Returns the type of a simple literal expression, or {@code null} if
+   * {@code n} is not a simple literal.
+   */
+  private JSType getLiteralType(Node n) {
+    switch (n.getType()) {
+      case Token.NULL:
+        return getNativeType(NULL_TYPE);
+      case Token.VOID:
+        return getNativeType(VOID_TYPE);
+      case Token.TRUE:
+      case Token.FALSE:
+        return getNativeType(BOOLEAN_TYPE);
+      case Token.NUMBER:
+        return getNativeType(NUMBER_TYPE);
+      case Token.STRING:
+        return getNativeType(STRING_TYPE);
+      case Token.NAME:
+        return "undefined".equals(n.getString()) ?
+            getNativeType(VOID_TYPE) : null;
+      default:
+        return null;
+    }
+  }
+
