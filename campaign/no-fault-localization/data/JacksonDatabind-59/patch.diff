+    /**
+     * Helper method called to ensure that key and/or content (de)serializers
+     * that were configured on {@code baseType} (via annotations) are retained
+     * on {@code narrowedType}, since narrowing (via {@link #_fromClass}) may
+     * end up returning a cached instance that was resolved without any such
+     * handlers.
+     *
+     * @since 2.8
+     */
+    private JavaType _copyHandlers(JavaType baseType, JavaType narrowedType)
+    {
+        if (narrowedType == null) {
+            return narrowedType;
+        }
+        if (baseType.isContainerType()) {
+            JavaType keyType = baseType.getKeyType();
+            if (keyType != null) {
+                Object h = keyType.getValueHandler();
+                if ((h != null) && narrowedType.isMapLikeType()) {
+                    JavaType newKeyType = narrowedType.getKeyType();
+                    if ((newKeyType != null) && (newKeyType.getValueHandler() != h)) {
+                        narrowedType = ((MapLikeType) narrowedType).withKeyValueHandler(h);
+                    }
+                }
+            }
+            JavaType contentType = baseType.getContentType();
+            if (contentType != null) {
+                JavaType newContentType = narrowedType.getContentType();
+                if (newContentType != null) {
+                    Object h = contentType.getValueHandler();
+                    if ((h != null) && (newContentType.getValueHandler() != h)) {
+                        narrowedType = narrowedType.withContentValueHandler(h);
+                        newContentType = narrowedType.getContentType();
+                    }
+                    Object th = contentType.getTypeHandler();
+                    if ((th != null) && (newContentType.getTypeHandler() != th)) {
+                        narrowedType = narrowedType.withContentTypeHandler(th);
+                    }
+                }
+            }
+        }
+        return narrowedType;
+    }
