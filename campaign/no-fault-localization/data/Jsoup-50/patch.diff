+    /**
+     * Inspect the leading bytes of the buffer for a byte-order-mark, and if found, return the corresponding
+     * charset name. Does not consume the buffer.
+     * @param byteData the buffer to inspect
+     * @return the charset name if a BOM was found, or null if not
+     */
+    private static String detectCharsetFromBom(ByteBuffer byteData) {
+        byteData.mark();
+        byte[] bom = new byte[4];
+        int available = Math.min(byteData.remaining(), bom.length);
+        byteData.get(bom, 0, available);
+        byteData.reset();
+
+        if (available >= 4 && bom[0] == 0x00 && bom[1] == 0x00 && bom[2] == (byte) 0xFE && bom[3] == (byte) 0xFF) {
+            return "UTF-32BE";
+        } else if (available >= 4 && bom[0] == (byte) 0xFF && bom[1] == (byte) 0xFE && bom[2] == 0x00 && bom[3] == 0x00) {
+            return "UTF-32LE";
+        } else if (available >= 3 && bom[0] == (byte) 0xEF && bom[1] == (byte) 0xBB && bom[2] == (byte) 0xBF) {
+            return "UTF-8";
+        } else if (available >= 2 && bom[0] == (byte) 0xFE && bom[1] == (byte) 0xFF) {
+            return "UTF-16BE";
+        } else if (available >= 2 && bom[0] == (byte) 0xFF && bom[1] == (byte) 0xFE) {
+            return "UTF-16LE";
+        }
+        return null;
+    }
