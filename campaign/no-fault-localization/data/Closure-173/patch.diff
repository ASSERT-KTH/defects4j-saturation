+  /**
+   * Rewrite "a op (b op c)" as "(a op b) op c" for associative operators so
+   * that the resulting expression trees are left-leaning, which is the
+   * natural order in which such expressions print without parentheses.
+   */
+  private Node tryRotateAssociativeOperator(Node n) {
+    Preconditions.checkState(NodeUtil.isAssociative(n.getType()));
+    Node right = n.getLastChild();
+    if (right.getType() != n.getType()) {
+      return n;
+    }
+
+    Node left = n.getFirstChild();
+    Node rightLeft = right.getFirstChild();
+    Node rightRight = right.getLastChild();
+
+    left.detachFromParent();
+    rightLeft.detachFromParent();
+    rightRight.detachFromParent();
+
+    Node newLeft = new Node(n.getType(), left, rightLeft)
+        .copyInformationFrom(n);
+    Node newRoot = new Node(n.getType(), newLeft, rightRight)
+        .copyInformationFrom(n);
+
+    n.getParent().replaceChild(n, newRoot);
+    reportCodeChange();
+    return newRoot;
+  }
