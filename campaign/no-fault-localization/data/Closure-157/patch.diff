+  /**
+   * Determines whether the given name consists exclusively of digits, e.g.
+   * as used to identify object literal keys, such as {@code 2}, that are
+   * always treated as numeric properties rather than as renamable names.
+   */
+  static boolean isSimpleNumber(String s) {
+    int len = s.length();
+    for (int index = 0; index < len; index++) {
+      char c = s.charAt(index);
+      if (c < '0' || c > '9') {
+        return false;
+      }
+    }
+    return len > 0;
+  }
