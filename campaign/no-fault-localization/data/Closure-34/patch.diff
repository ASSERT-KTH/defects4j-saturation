+      // Descend along the chain of left-hand ("first") children as long as
+      // they are themselves binary operators of no lower precedence, so
+      // that deeply left-nested expressions (e.g. "a+a+a+...+a") can be
+      // printed iteratively instead of blowing the stack with recursion.
+      Deque<Node> chain = new ArrayDeque<Node>();
+      Node current = n;
+      while (true) {
+        chain.push(current);
+        Node curFirst = current.getFirstChild();
+        String curFirstOpstr = NodeUtil.opToStr(curFirst.getType());
+        if (curFirstOpstr != null &&
