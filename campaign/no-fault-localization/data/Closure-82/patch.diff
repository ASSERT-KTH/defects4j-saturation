--- a/src/com/google/javascript/rhino/jstype/FunctionType.java
+++ b/src/com/google/javascript/rhino/jstype/FunctionType.java
@@ -187,6 +187,15 @@ public class FunctionType extends PrototypeObjectType {
     return true;
   }
 
+  @Override
+  public boolean isEmptyType() {
+    // The least function type, i.e. (All...) -> NoType, is the bottom of the
+    // function lattice, so it must be considered empty even though it is not
+    // NoType/NoObjectType/NoResolvedType itself.
+    return super.isEmptyType() ||
+        (isOrdinaryFunction() && call.returnType.isEmptyType());
+  }
+
   @Override
   public boolean canBeCalled() {
     return true;
