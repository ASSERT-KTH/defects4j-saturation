+   * appeared on the command line. Used to preserve the relative ordering
+   * of repeated flags (e.g. --jscomp_error, --jscomp_warning, --jscomp_off)
+   * so that later flags can override earlier ones.
+   */
+  static class FlagEntry<T> {
+    private final T flag;
+    private final String value;
+
+    FlagEntry(T flag, String value) {
+      this.flag = flag;
+      this.value = value;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+      if (other instanceof FlagEntry) {
+        FlagEntry<?> that = (FlagEntry<?>) other;
+        return that.flag.equals(this.flag) && that.value.equals(this.value);
+      }
+      return false;
+    }
+
+    @Override
+    public int hashCode() {
+      return flag.hashCode() + value.hashCode();
+    }
+  }
