+  /**
+   * Scans the already-processed (i.e. "--flag=value" split into separate
+   * "--flag" and "value" tokens) argument list for occurrences of
+   * --jscomp_error, --jscomp_warning and --jscomp_off, recording them in
+   * the order they appear so that later flags can override earlier ones
+   * for the same diagnostic group.
+   */
+  private void recordWarningGuardSpec(List<String> processedArgs) {
+    for (int i = 0; i < processedArgs.size() - 1; i++) {
+      String flagName = processedArgs.get(i);
+      String flagValue = processedArgs.get(i + 1);
+      if ("--jscomp_error".equals(flagName)) {
+        flags.warningGuardSpec.add(
+            new FlagEntry<CheckLevel>(CheckLevel.ERROR, flagValue));
+      } else if ("--jscomp_warning".equals(flagName)) {
+        flags.warningGuardSpec.add(
+            new FlagEntry<CheckLevel>(CheckLevel.WARNING, flagValue));
+      } else if ("--jscomp_off".equals(flagName)) {
+        flags.warningGuardSpec.add(
+            new FlagEntry<CheckLevel>(CheckLevel.OFF, flagValue));
+      }
+    }
+  }
