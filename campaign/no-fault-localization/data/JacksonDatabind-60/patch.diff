+        }
+
+        @Override
+        public TypeSerializer forProperty(BeanProperty prop) {
+            TypeSerializer ts = _typeSerializer.forProperty(prop);
+            return (ts == _typeSerializer) ? this : new TypeSerializerRerouter(ts, _forObject);
+        }
