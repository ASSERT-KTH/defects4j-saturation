+    /**
+     * Helper method used to allow "refinements" between primitive/wrapper pairs
+     * (like `int` and `Integer`) that are not sub/super-types of each other but
+     * are otherwise fully compatible: such refinements are simply ignored.
+     *
+     * @since 2.9 (see [databind#1592])
+     */
+    private static boolean _isPrimitiveWrapperPair(Class<?> type1, Class<?> type2)
+    {
+        if (type1.isPrimitive() == type2.isPrimitive()) {
+            return false;
+        }
+        Class<?> prim1 = ClassUtil.primitiveType(type1);
+        return (prim1 != null) && (prim1 == ClassUtil.primitiveType(type2));
+    }
