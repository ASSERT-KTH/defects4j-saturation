+    /**
+     A stack of open elements that also tracks, per tag name, how many elements with that name are currently on the
+     stack. Scope searches (e.g. {@link #inSpecificScope}) walk the stack from the top down until they find their
+     target or a scope boundary; on deeply nested documents with no matching target (e.g. thousands of nested
+     {@code <dl><dd>} with no open {@code <p>}), that walk is O(stack size) per call. Keeping a running count lets
+     those searches return immediately when the target tag isn't open anywhere on the stack.
+     */
+    private static class TagCountingStack extends ArrayList<Element> {
+        private final Map<String, Integer> tagCounts = new HashMap<>();
+
+        boolean hasTag(String tagName) {
+            Integer count = tagCounts.get(tagName);
+            return count != null && count > 0;
+        }
+
+        private void trackAdd(Element element) {
+            String name = element.nodeName();
+            Integer count = tagCounts.get(name);
+            tagCounts.put(name, count == null ? 1 : count + 1);
+        }
+
+        private void trackRemove(Element element) {
+            String name = element.nodeName();
+            Integer count = tagCounts.get(name);
+            if (count == null)
+                return;
+            if (count > 1)
+                tagCounts.put(name, count - 1);
+            else
+                tagCounts.remove(name);
+        }
+
+        @Override
+        public boolean add(Element element) {
+            trackAdd(element);
+            return super.add(element);
+        }
+
+        @Override
+        public void add(int index, Element element) {
+            trackAdd(element);
+            super.add(index, element);
+        }
+
+        @Override
+        public Element remove(int index) {
+            Element removed = super.remove(index);
+            trackRemove(removed);
+            return removed;
+        }
+
+        @Override
+        public boolean remove(Object o) {
+            boolean removed = super.remove(o);
+            if (removed && o instanceof Element)
+                trackRemove((Element) o);
+            return removed;
+        }
+
+        @Override
+        public Element set(int index, Element element) {
+            Element previous = super.set(index, element);
+            trackRemove(previous);
+            trackAdd(element);
+            return previous;
+        }
+    }
